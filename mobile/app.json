{
  "expo": {
    "name": "CokieCollege",
    "slug": "cokie-college",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "../CokieCollegeMockUp/img/CokieCollege.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "../CokieCollegeMockUp/img/CokieCollege.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1957"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cokiecollege.app"
    },
    "android": {
      "package": "com.cokiecollege.app",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "../CokieCollegeMockUp/img/CokieCollege.png",
        "backgroundColor": "#0B1957"
      }
    },
    "web": {
      "favicon": "../CokieCollegeMockUp/img/CokieCollege.png",
      "bundler": "metro"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/fd2a2f1c-190e-4d55-90ec-58fa0db18620"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-notifications",
        {
          "icon": "../CokieCollegeMockUp/img/CokieCollege.png",
          "color": "#0B1957"
        }
      ]
    ],
    "scheme": "cokie-college",
    "extra": {
      "supabaseUrl": "your_supabase_url",
      "supabaseAnonKey": "your_supabase_anon_key",
      "router": {},
      "eas": {
        "projectId": "fd2a2f1c-190e-4d55-90ec-58fa0db18620"
      }
    },
    "owner": "diaz_jl"
  }
}
