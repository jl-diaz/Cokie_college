{
  "name": "cokie-interpreter",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export -p web",
    "build:apk": "eas build -p android --profile preview",
    "build:bundle": "eas build -p android --profile production",
    "build:all": "eas build --all",
    "postinstall": "node -e \"try{require('fs').chmodSync('node_modules/hermes-compiler/hermesc/linux64-bin/hermesc', '755')}catch(e){}\""
  },
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "axios": "^1.7.2",
    "expo": "^57.0.24",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "~57.0.21",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-haptics": "~57.0.3",
    "expo-image-manipulator": "~57.0.19",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "expo-speech": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.23",
    "lucide-react-native": "^0.395.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-get-random-values": "~1.11.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0"
  },
  "private": true
}
