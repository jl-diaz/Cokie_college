{
  "expo": {
    "name": "CokieInterpreter",
    "slug": "cokie-interpreter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0F17"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cokieinterpreter.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIDesignRequiresCompatibility": true,
        "UIViewControllerBasedStatusBarAppearance": true,
        "NSCameraUsageDescription": "CokieInterpreter necesita acceso a la cámara para traducir lenguaje de señas en tiempo real.",
        "NSMicrophoneUsageDescription": "CokieInterpreter utiliza audio para la síntesis de voz.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.cokieinterpreter.app",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "pan",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0F17"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro",
      "name": "CokieInterpreter - Intérprete de Lenguaje de Señas",
      "shortName": "CokieInterpreter",
      "themeColor": "#0B0F17",
      "backgroundColor": "#0B0F17",
      "display": "standalone"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "CokieInterpreter necesita acceso a la cámara para traducir el lenguaje de señas en tiempo real."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": false
          }
        }
      ],
      "expo-status-bar",
      "expo-audio"
    ],
    "scheme": "cokie-interpreter",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cokie-interpreter-eas"
      },
      "signLanguageServerUrl": "https://cokie-college.onrender.com"
    }
  }
}
